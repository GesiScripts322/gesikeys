<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GesiKeys</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, 'Segoe UI', sans-serif;
    background: #0a0a0a;
    color: #e6e6e6;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .card {
    background: #0a0a0a;
    border: 1px solid #282828;
    border-radius: 12px;
    padding: 36px 28px;
    max-width: 400px;
    width: 100%;
    text-align: center;
  }
  h1 {
    font-size: 20px;
    margin-bottom: 6px;
    color: #e6e6e6;
    font-weight: 500;
    letter-spacing: 0.5px;
  }
  .sub {
    font-size: 12px;
    color: #787878;
    margin-bottom: 28px;
  }
  .step { display: none; }
  .step.active { display: block; animation: fade 0.3s ease; }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  button {
    width: 100%;
    padding: 14px;
    font-size: 13px;
    font-weight: 500;
    border: 1px solid #282828;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
    background: #181818;
    color: #e6e6e6;
    letter-spacing: 0.3px;
  }
  button:hover:not(:disabled) { background: #282828; border-color: #505050; }
  button:active:not(:disabled) { transform: scale(0.98); }
  button:disabled { opacity: 0.4; cursor: not-allowed; }
  .icon { font-size: 40px; margin-bottom: 20px; display: block; opacity: 0.7; }
  .info {
    font-size: 12px;
    color: #a0a0a0;
    line-height: 1.6;
    margin-bottom: 22px;
  }
  .progress {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-bottom: 28px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #282828;
    transition: all 0.3s;
  }
  .dot.active { background: #e6e6e6; width: 20px; border-radius: 3px; }
  .footer {
    font-size: 10px;
    color: #505050;
    margin-top: 26px;
    letter-spacing: 0.5px;
  }
  .badge-step {
    display: inline-block;
    background: transparent;
    color: #787878;
    padding: 4px 12px;
    border-radius: 10px;
    font-size: 10px;
    font-weight: 500;
    margin-bottom: 14px;
    border: 1px solid #282828;
    letter-spacing: 0.5px;
  }
</style>
</head>
<body>
  <div class="card">
    <div class="progress">
      <div class="dot active" id="dot1"></div>
      <div class="dot" id="dot2"></div>
    </div>

    <!-- ETAPA 1 -->
    <div class="step active" id="step1">
      <span class="icon">🔑</span>
      <h1>GesiKeys</h1>
      <p class="sub">Obtenha sua chave de acesso</p>
      <p class="info">
        Para liberar o painel, passe por <b>1 verificação</b>.<br>
        A chave expira em <b>10 minutos</b>.
      </p>
      <button onclick="irParaEtapa(2)">COMEÇAR</button>
    </div>

    <!-- ETAPA 2 -->
    <div class="step" id="step2">
      <span class="badge-step">VERIFICAÇÃO</span>
      <span class="icon">🔗</span>
      <h1>Verificação</h1>
      <p class="info">
        Clique abaixo para abrir a verificação.<br>
        Ao concluir, você será levado direto para sua chave.
      </p>
      <button id="btnLink" onclick="abrirLink()">IR PARA VERIFICAÇÃO</button>
    </div>

    <div class="footer">GESISCRIPTS • SISTEMA OFICIAL</div>
  </div>

  <script>
    // ⚙️ COLE AQUI SEU LINK DO LINKVERTISE
    const LINKVERTISE = "https://link-target.net/3034355/MzuyT3bXqQKI";

    const dots = [1,2].map(i => document.getElementById("dot" + i));
    const steps = [1,2].map(i => document.getElementById("step" + i));

    function irParaEtapa(n) {
      steps.forEach((s, i) => s.classList.toggle("active", i === n - 1));
      dots.forEach((d, i) => d.classList.toggle("active", i < n));
    }

    function abrirLink() {
      const btn = document.getElementById("btnLink");
      btn.disabled = true;
      btn.textContent = "ABRINDO...";
      window.location.href = LINKVERTISE;
    }
  </script>
</body>
</html>
